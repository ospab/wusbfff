{
  "manifest_version": 2,
  "name": "wusbfff",
  "version": "0.2.0",
  "description": "Adds navigator.usb (WebUSB) to Firefox through a native libusb bridge.",
  "homepage_url": "https://github.com/ospab/wusbfff",
  "browser_specific_settings": {
    "gecko": {
      "id": "wusbfff@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["nativeMessaging", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
